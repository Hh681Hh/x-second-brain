# All secrets are server-side. Copy this to .env; never commit .env.
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# Optional access token. Required when HOST is not a loopback address.
APP_TOKEN=
# Daily use is the free browser extension + background reader + Codex Skill.
HEADLESS=true
# codex uses the installed, logged-in Codex CLI; api uses Chat Completions below.
LLM_PROVIDER=codex
CODEX_BINARY=codex
# OpenAI-compatible Chat Completions endpoint, including /v1.
# To use Ollama: http://127.0.0.1:11434/v1, LLM_API_KEY=ollama
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=600
LLM_JSON_MODE=true
# Optional schema-constrained output, if your provider supports it.
LLM_JSON_SCHEMA=false
LLM_MAX_TOKENS=6500
# Background article readers (1-3). Use 2 for a historical bookmark import.
KNOWLEDGE_WORKERS=1
# local (CPU, downloads about 90 MB on first indexing), api, or none.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
# Calibrate for your embedding model; not a probability or confidence score.
SEMANTIC_THRESHOLD=0.40
# X official post lookup only. Optional; may incur X API charges.
# This is NOT an account password or browser cookie.
X_BEARER_TOKEN=
# Thread lookup uses official recent search; opt-in because it adds cost.
X_FETCH_THREADS=false
X_THREAD_MAX_PAGES=2
# Official bookmark OAuth. Client ID can also be saved in the web sync page.
X_CLIENT_ID=
# Only confidential Web App / automated app clients require this; keep server-side.
X_CLIENT_SECRET=
# Register the exact URI in your X App. Empty uses local 127.0.0.1 + PORT.
X_REDIRECT_URI=http://127.0.0.1:8787/api/integrations/x/callback
# Optional for a VPN using Fake-IP 198.18/15. Never permits LAN/loopback targets.
FETCH_ALLOW_BENCHMARK_PROXY=false
# Optional NON-OFFICIAL public fulltext lookup. Default none: no bookmark IDs sent.
# fxembed sends incomplete new bookmark post IDs to api.fxtwitter.com.
# Enable only after the user accepts this third-party disclosure and platform uncertainty.
X_PUBLIC_FULLTEXT_PROVIDER=none
LOG_LEVEL=INFO
